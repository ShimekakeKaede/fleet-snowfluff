{
  "name": "fleet-snowfluff",
  "displayName": "Fleet Snowfluff",
  "description": "《鸣潮》飞行雪绒 — 克隆仓库后运行 scripts/setup.ps1 即可本地安装完整体验（主题 + Vibrancy 叠加）。",
  "version": "0.1.0",
  "publisher": "fleet-snowfluff",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#111111",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "cursor",
    "wuthering-waves",
    "鸣潮",
    "飞行雪绒"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Fleet Snowfluff Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/fleet-snowfluff-dark.color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "fleet.python-import.injection",
        "path": "./themes/fleet-python-import.tmLanguage.json",
        "injectTo": ["source.python"]
      }
    ],
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true,
      "workbench.colorCustomizations": {
        "[Fleet Snowfluff Dark]": {
          "sideBar.background": "#00000000",
          "tree.tableOddRowsBackground": "#00000000",
          "terminal.background": "#000000B3",
          "panel.background": "#000000B3"
        }
      }
    }
  }
}
