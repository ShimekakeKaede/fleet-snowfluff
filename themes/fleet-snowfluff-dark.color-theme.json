  "tokenColors": [
    {
      "name": "Whiteboard — Default (non-Python / fallback)",
      "scope": [
        "source",
        "text",
        "variable",
        "keyword",
        "string",
        "comment",
        "constant",
        "entity",
        "support",
        "storage",
        "punctuation",
        "meta"
      ],
      "settings": {
        "foreground": "#E8E8E8"
      }
    },
    {
      "name": "Python — Comments",
      "scope": [
        "comment.line.number-sign.python",
        "comment.block.documentation.python",
        "comment.line.python",
        "punctuation.definition.comment.python"
      ],
      "settings": {
        "foreground": "#6B7A8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python — Keywords",
      "scope": [
        "keyword.control.flow.python",
        "keyword.control.import.python",
        "keyword.control.def.python",
        "keyword.control.async.python",
        "keyword.control.await.python",
        "storage.type.function.python",
        "storage.type.function.async.python",
        "storage.type.function.lambda.python",
        "storage.type.class.python",
        "storage.modifier.declaration.python",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike.python"
      ],
      "settings": {
        "foreground": "#4A9EFF"
      }
    },
    {
      "name": "Python — Types & Classes",
      "scope": [
        "entity.name.type.class.python",
        "entity.name.class.python",
        "entity.name.type.class.import.python",
        "entity.name.namespace.import.python",
        "entity.other.inherited-class.python",
        "support.type.python",
        "support.type.exception.python",
        "meta.fleet.import-list.parenthesized.python entity.name.type.class.import.python",
        "meta.fleet.import-list.parenthesized.python entity.name.function.import.python"
      ],
      "settings": {
        "foreground": "#B090F0"
      }
    },
    {
      "name": "Python — Functions & Methods",
      "scope": [
        "entity.name.function.python",
        "entity.name.function.decorator.python",
        "entity.name.function.import.python",
        "meta.function-call.generic.python",
        "support.function.builtin.python",
        "support.function.magic.python",
        "entity.name.function.import.python",
        "meta.fleet.import-list.parenthesized.python entity.name.function.import.python"
      ],
      "settings": {
        "foreground": "#FF8FAB"
      }
    },
    {
      "name": "Python — Variables & Parameters",
      "scope": [
        "variable.parameter.python",
        "variable.parameter.function.python",
        "variable.parameter.function.language.python",
        "variable.parameter.function-call.python",
        "variable.language.special.self.python",
        "variable.language.special.cls.python",
        "meta.indexed-name.python"
      ],
      "settings": {
        "foreground": "#B0C4E0"
      }
    },
    {
      "name": "Python — Docstrings",
      "scope": [
        "string.quoted.docstring.multi.python",
        "string.quoted.docstring.raw.multi.python",
        "string.quoted.docstring.single.python",
        "string.quoted.docstring.raw.single.python"
      ],
      "settings": {
        "foreground": "#E8E8E8"
      }
    },
    {
      "name": "Python — Strings",
      "scope": [
        "string.quoted.single.python",
        "string.quoted.double.python",
        "string.quoted.multi.python",
        "string.quoted.raw.single.python",
        "string.quoted.raw.multi.python",
        "string.quoted.binary.single.python",
        "string.quoted.binary.multi.python",
        "string.quoted.raw.binary.single.python",
        "string.quoted.raw.binary.multi.python",
        "string.interpolated.python",
        "string.regexp.quoted.single.python",
        "string.regexp.quoted.double.python"
      ],
      "settings": {
        "foreground": "#FF7A45"
      }
    },
    {
      "name": "Python — Literal Modifiers",
      "scope": [
        "storage.type.number.python",
        "storage.type.imaginary.number.python",
        "storage.type.string.python"
      ],
      "settings": {
        "foreground": "#92DED9"
      }
    },
    {
      "name": "Python — Constants & Numbers",
      "scope": [
        "constant.numeric.python",
        "constant.numeric.bin.python",
        "constant.numeric.oct.python",
        "constant.numeric.hex.python",
        "constant.numeric.dec.python",
        "constant.numeric.float.python",
        "constant.language.python",
        "constant.other.caps.python",
        "constant.other.ellipsis.python",
        "keyword.illegal.name.python"
      ],
      "settings": {
        "foreground": "#F6C343"
      }
    },
    {
      "name": "Python — Brackets & Grouping",
      "scope": [
        "punctuation.parenthesis.begin.python",
        "punctuation.parenthesis.end.python",
        "punctuation.definition.arguments.begin.python",
        "punctuation.definition.arguments.end.python",
        "punctuation.definition.parameters.begin.python",
        "punctuation.definition.parameters.end.python",
        "punctuation.definition.inheritance.begin.python",
        "punctuation.definition.inheritance.end.python",
        "punctuation.definition.list.begin.python",
        "punctuation.definition.list.end.python",
        "punctuation.definition.dict.begin.python",
        "punctuation.definition.dict.end.python",
        "punctuation.section.class.begin.python",
        "punctuation.section.function.begin.python",
        "punctuation.section.function.lambda.begin.python"
      ],
      "settings": {
        "foreground": "#D8DCE0"
      }
    },
    {
      "name": "Python — Punctuation & Operators",
      "scope": [
        "punctuation.separator.period.python",
        "punctuation.separator.arguments.python",
        "punctuation.definition.string.begin.python",
        "punctuation.definition.string.end.python",
        "punctuation.separator.inheritance.python",
        "punctuation.separator.import.python",
        "keyword.operator.arithmetic.python",
        "keyword.operator.comparison.python",
        "keyword.operator.assignment.python",
        "keyword.operator.unpacking.arguments.python",
        "keyword.operator.unpacking.parameter.python",
        "keyword.operator.positional.parameter.python"
      ],
      "settings": {
        "foreground": "#FFFFFF80"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.illegal.python",
        "invalid.illegal.newline.python"
      ],
      "settings": {
        "foreground": "#FF7A45"
      }
    },
    {
      "name": "Python — String Escapes (override)",
      "scope": [
        "string.quoted.single.python constant.character.escape.python",
        "string.quoted.double.python constant.character.escape.python",
        "string.quoted.multi.python constant.character.escape.python",
        "string.quoted.raw.single.python constant.character.escape.python",
        "string.quoted.raw.multi.python constant.character.escape.python",
        "string.quoted.binary.single.python constant.character.escape.python",
        "string.quoted.binary.multi.python constant.character.escape.python",
        "string.interpolated.python constant.character.escape.python",
        "string.quoted.docstring.multi.python constant.character.escape.python",
        "string.quoted.docstring.single.python constant.character.escape.python",
        "constant.character.escape.python"
      ],
      "settings": {
        "foreground": "#C85874"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment:python": {
      "foreground": "#6B7A8C",
      "fontStyle": "italic"
    },
    "keyword:python": "#4A9EFF",
    "class:python": "#B090F0",
    "interface:python": "#B090F0",
    "enum:python": "#B090F0",
    "struct:python": "#B090F0",
    "type:python": "#B090F0",
    "typeParameter:python": "#B090F0",
    "namespace:python": "#B090F0",
    "module:python": "#B090F0",
    "function:python": "#FF8FAB",
    "method:python": "#FF8FAB",
    "variable:python": "#B0C4E0",
    "parameter:python": "#B0C4E0",
    "property:python": "#B0C4E0",
    "selfParameter:python": "#B0C4E0",
    "number:python": "#F6C343",
    "boolean:python": "#F6C343",
    "enumMember:python": "#F6C343",
    "variable.readonly:python": "#F6C343",
    "property.readonly:python": "#F6C343",
    "operator:python": "#FFFFFF80",
    "*.readonly:python": {
      "foreground": "#F6C343"
    }
  }
}
